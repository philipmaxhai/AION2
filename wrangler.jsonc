// Cloudflare Worker: liefert die Website aus und beantwortet /api/* über den Armory-Proxy.
// Der Name muss zum Worker im Cloudflare-Dashboard passen.
{
  "name": "aion2",
  "main": "proxy/worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
